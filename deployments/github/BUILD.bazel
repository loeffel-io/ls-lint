load("@aspect_bazel_lib//lib:copy_to_directory.bzl", "copy_to_directory")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("//cmd:target.bzl", "targets")

copy_to_directory(
    name = "github_files",
    srcs = ["//cmd/ls_lint:checksums.txt"] + [
        "//cmd/ls_lint:ls-lint-" + goos + "-" + goarch
        for goos, goarch in targets
    ] + [
        "//cmd/ls_lint:ls-lint-" + goos + "-" + goarch + "-pkg"
        for goos, goarch in targets
    ] + [
        "//cmd/ls_lint_mcp:ls-lint-mcp-" + goos + "-" + goarch
        for goos, goarch in targets
    ] + [
        "//cmd/ls_lint_mcp:ls-lint-mcp-" + goos + "-" + goarch + "-pkg"
        for goos, goarch in targets
    ],
    out = "github",
    root_paths = [
        "cmd/ls_lint/ls-lint-" + goos + "-" + goarch + "_"
        for goos, goarch in targets
    ] + [
        "cmd/ls_lint"
        for goos, goarch in targets
    ] + [
        "cmd/ls_lint_mcp/ls-lint-mcp-" + goos + "-" + goarch + "_"
        for goos, goarch in targets
    ] + [
        "cmd/ls_lint_mcp"
        for goos, goarch in targets
    ],
)

sh_binary(
    name = "ls_lint_publish",
    srcs = [":github.sh"],
    args = [
        "$(location //:gh)",
        "$(location :github_files)/*",
    ],
    data = [
        ":github_files",
        "//:gh",
    ],
)
